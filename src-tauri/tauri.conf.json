{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Afterdusk",
  "version": "0.5.0",
  "identifier": "app.afterdusk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Afterdusk",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 600,
        "backgroundColor": "#17191C",
        "label": "main",
        "visible": false,
        "center": true
      },
      {
        "label": "welcome",
        "title": "Afterdusk",
        "width": 1040,
        "height": 700,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "backgroundColor": "#17191C"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' preview: http://preview.localhost data: blob:; media-src 'self' video: http://video.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://tiles.openfreemap.org; worker-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/onnxruntime/": "onnxruntime/",
      "resources/ffmpeg/": "ffmpeg/"
    },
    "category": "Photography",
    "copyright": "© 2026 Lewis Bedar",
    "shortDescription": "Gestion photo open source",
    "publisher": "Flux Croisés",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsh",
        "languages": ["French", "English"],
        "displayLanguageSelector": false
      }
    },
    "license": "GPL-3.0-or-later"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzMDg0QUMxOEYxMERFRjMKUldUejNoQ1B3VW9JZ3dKQTQ5REdvd2MyZmxES0lBbExuVFByYmdmL1I2WVVwSlZMWVg1UEJHTWcK",
      "endpoints": [
        "https://github.com/lewisbedar/afterdusk-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
